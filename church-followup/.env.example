# Copy this file to ".env" and fill in what you have. Nothing here is required
# to RUN the app — with no Twilio keys it stays in safe dry-run mode.

# --- Basics ---
CHURCH_NAME=Grace Family Church
PORT=3000
# The public address once hosted (used to build the QR link). Leave default while testing.
BASE_URL=http://localhost:3000
# Password for the staff dashboard (username is always "admin"). CHANGE THIS.
ADMIN_PASSWORD=changeme
# Nigeria country code.
DEFAULT_COUNTRY_CODE=234

# --- Go live with messaging (optional, add when your Twilio account is ready) ---
# Set to true ONLY when the Twilio values below are filled in.
MESSAGING_LIVE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender from Twilio, e.g. whatsapp:+14155238886 (sandbox) or your approved number
TWILIO_WHATSAPP_FROM=
# SMS-capable Twilio number, e.g. +1XXXXXXXXXX
TWILIO_SMS_FROM=
# Optional email sender (email live-send not wired in the prototype yet)
EMAIL_FROM=
